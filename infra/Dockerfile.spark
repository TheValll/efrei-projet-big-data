FROM apache/spark:3.5.1

USER root

ENV DEBIAN_FRONTEND=noninteractive

ARG PY_VERSION=3.11.10
ARG PY_BUILD=20240909
ARG PY_TARBALL_URL=https://github.com/astral-sh/python-build-standalone/releases/download/${PY_BUILD}/cpython-${PY_VERSION}+${PY_BUILD}-x86_64-unknown-linux-gnu-install_only.tar.gz

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl && \
    rm -rf /var/lib/apt/lists/* && \
    curl -fsSL "${PY_TARBALL_URL}" -o /tmp/python.tar.gz && \
    tar -xzf /tmp/python.tar.gz -C /opt && \
    rm /tmp/python.tar.gz && \
    ln -sf /opt/python/bin/python3.11 /usr/bin/python3.11 && \
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 100 && \
    update-alternatives --install /usr/bin/python  python  /usr/bin/python3.11 100

USER spark
