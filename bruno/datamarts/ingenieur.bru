meta {
  name: Ingenieur
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/datamarts/ingenieur?from=2010-01-01&to=2020-12-31&limit=100&offset=0
  body: none
  auth: bearer
}

params:query {
  from: 2010-01-01
  to: 2020-12-31
  limit: 100
  offset: 0
}

auth:bearer {
  token: {{access_token}}
}

docs {
  Monthly average calibration time per instrument with 12-month trend.
  Optional date filters apply on `year_month` (YYYY-MM-DD --- the 1st of the month is fine).
}
